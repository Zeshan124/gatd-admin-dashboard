# GATD static site — live blog fallback.
# Any /blog/<slug>/ URL without a pre-built static file is routed to the client
# renderer template (/blog/__slug__/index.html), which reads the real slug from
# the URL and fetches the post from the API. This is what makes brand-new blog
# posts appear without rebuilding the site.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # XML sitemap — served live by the backend API (auto-includes new CMS content).
  # Exposed here at https://globalatd.com/sitemap.xml. A 302 redirect works on all
  # shared hosting; if this server has mod_proxy enabled you may instead use the
  # commented proxy rule below to serve it on this host directly.
  RewriteRule ^sitemap\.xml$ https://api.globalatd.com/sitemap.xml [R=302,L]
  # RewriteRule ^sitemap\.xml$ https://api.globalatd.com/sitemap.xml [P,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^blog/[^/]+/?$ /blog/__slug__/index.html [L]

  # Solutions CMS — client-rendered fallbacks (same idea as the blog above).
  # Subprogram pages: /solutions/<program>/<subprogram>/ (2 segments).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^solutions/[^/]+/[^/]+/?$ /solutions/__slug__/__program__/index.html [L]

  # Program pages: /solutions/<program>/ (1 segment).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^solutions/[^/]+/?$ /solutions/__slug__/index.html [L]
</IfModule>
